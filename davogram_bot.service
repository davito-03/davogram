[Unit]
Description=DavoGram Telegram Bot
After=network.target

[Service]
# ─── RUTAS EN /opt/ (junto con el resto de servicios) ───────────────────────
User=root
WorkingDirectory=/opt/davogram
ExecStart=/opt/davogram/venv/bin/python main.py
# ─────────────────────────────────────────────────────────────────────────────

# Reiniciar automáticamente si el proceso muere
Restart=always
RestartSec=10

# Opcional: pasa el token como variable de entorno en lugar de hardcodearlo
# Environment=BOT_TOKEN=tu_token_aqui

# Logs capturados por journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=davogram-bot

[Install]
WantedBy=multi-user.target
